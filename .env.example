# Copy this file to .env.local for local dev, or add the same variable
# in Vercel: Project Settings → Environment Variables.

# Required for the NOVA AI tab to give real answers instead of a setup message.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shopee Open Platform (open.shopee.com) — register an app to get these.
SHOPEE_PARTNER_ID=2037048
SHOPEE_PARTNER_KEY= # set in Vercel, not here
SHOPEE_HOST=https://partner.shopeemobile.com

# Lazada Open Platform (open.lazada.com) — register an app to get these.
LAZADA_APP_KEY=140329
LAZADA_APP_SECRET= # set in Vercel, not here
LAZADA_REGION=my
